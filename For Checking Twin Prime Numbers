def IsPrime(num):
    if num<=1:
        return False
    for i in range(2, num):
        if num%i==0:
            return False
    return True
    

num1 = int(input("Enter first Number: "))
num2 = int(input("Enter Second Numbers: "))

if IsPrime(num1) and IsPrime(num2):
    if abs(num1-num2)==2:
        print(f"{num1} and {num2} is a twin prime numbers")
    else:
        print(f"{num1} and {num2} is not a prime numbers.")
else:
    print("Numbers are not prime")

