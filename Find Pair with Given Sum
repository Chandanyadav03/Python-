## Find Pair with Given Sum

arr = [2, 7, 11, 15]
target = 9

for i in range(len(arr)):
    for j in range(i + 1, len(arr)):
        if arr[i] + arr[j] == target:
            print("Pair:", arr[i], arr[j])

==================================================================

arr = [2, 7, 11, 15]
target = 9

seen = set()

for num in arr:
    needed = target - num

    if needed in seen:
        print("Pair:", needed, num)
        break

    seen.add(num)
