## 50. Implement a Stack Using an Array



stack = []

# Push
stack.append(10)
stack.append(20)
stack.append(30)

print("Stack:", stack)

# Pop
item = stack.pop()
print("Removed:", item)

# Peek
print("Top:", stack[-1])

# Check empty
if len(stack) == 0:
    print("Stack is empty")
else:
    print("Stack is not empty")
