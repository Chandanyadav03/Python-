## Merge Two Sorted Arrays

arr1 = [1, 3, 5]
arr2 = [2, 4, 6]

result = sorted(arr1 + arr2)
print(result)

=================================================
Two pointers = two variables that keep track of positions (indexes) in an array.

arr1 = [10, 20, 30]
arr2 = [15, 25, 40]

merged = []

i = 0
j = 0

while i < len(arr1) and j < len(arr2):

    if arr1[i] < arr2[j]:
        merged.append(arr1[i])
        i = i + 1
    else:
        merged.append(arr2[j])
        j = j + 1

while i < len(arr1):
    merged.append(arr1[i])
    i = i + 1

while j < len(arr2):
    merged.append(arr2[j])
    j = j + 1

print("Merged array:", merged)
