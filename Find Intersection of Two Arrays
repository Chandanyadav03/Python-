## Find Intersection of Two Arrays
## Intersection means elements that are present in both arrays.


arr1 = [10, 20, 30, 40]
arr2 = [30, 40, 50, 60]

set1 = set(arr1)
set2 = set(arr2)

intersection = set1 & set2
print("Intersection:", intersection)

===================================================

arr1 = [10, 20, 30, 40]
arr2 = [30, 40, 50, 60]

intersection = []

for num in arr1:
    if num in arr2:
        intersection.append(num)

print("Intersection:", intersection)
