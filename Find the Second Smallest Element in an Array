## Find the Second Smallest Element in an Array


arr = [10, 25, 7, 45, 18]

smallest = arr[0]
second_smallest = arr[0]

for num in arr:
    if num < smallest:
        second_smallest = smallest
        smallest = num
    elif num < second_smallest and num != smallest:
        second_smallest = num

print("Smallest:", smallest)
print("Second smallest:", second_smallest)
