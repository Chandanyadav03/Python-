## Remove Duplicate Elements from an Array/List


arr = [10, 20, 10, 30, 20, 40]
unique = []

for num in arr:
    if num not in unique:
        unique.append(num)

print("Array after removing duplicates:", unique)

---------------------------------------------------------------------

arr = [10, 20, 10, 30, 20, 40]

unique = list(set(arr))

print(unique)
