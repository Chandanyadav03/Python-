## Find Missing Number in an Array

arr = [1, 2, 3, 5]

for i in range(1, 6):
    if i not in arr:
        print("Missing number:", i)

=====================================================================

arr = [1, 2, 3, 5]
n = 5

total = n * (n + 1) // 2

actual = sum(arr)

missing = total - actual

print("Missing number:", missing)
