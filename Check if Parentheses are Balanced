## Check if Parentheses are Balanced

s = "(()())"
stack = []

for char in s:
    if char == '(':
        stack.append(char)

    elif char == ')':
        if len(stack) == 0:
            print("Not Balanced")
            break

        stack.pop()

else:
    if len(stack) == 0:
        print("Balanced")
    else:
        print("Not Balanced")

