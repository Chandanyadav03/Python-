s = "(()())"
count = 0

for char in s:
    if char == '(':
        count += 1

    elif char == ')':
        count -= 1

    if count < 0:
        print("Not Balanced")
        break

else:
    if count == 0:
        print("Balanced")
    else:
        print("Not Balanced")
